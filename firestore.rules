rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getCurrentUserRole(companyId) {
      return getUserDoc(request.auth.uid).role;
    }

    function isOwnerRole(role) {
      return role in ['owner', 'Owner', 'OWNER'];
    }

    function isAdminRole(role) {
      return role in ['admin', 'Admin', 'ADMIN'];
    }

    function isManagerRole(role) {
      return role in ['manager', 'Manager', 'MANAGER'];
    }

    function isViewerRole(role) {
      return role in ['viewer', 'Viewer', 'VIEWER'];
    }

    function canRoleReadSubmissions(role) {
      return isOwnerRole(role) || isAdminRole(role) || isManagerRole(role) || isViewerRole(role);
    }

    function canRoleManageSubmissions(role) {
      return isOwnerRole(role) || isAdminRole(role) || isManagerRole(role);
    }

    function canRoleManageCompany(role) {
      return isOwnerRole(role) || isAdminRole(role);
    }

    function isUserInCompany(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc(request.auth.uid).companyId == companyId;
    }

    function hasRolePermission(companyId, permission) {
      let role = getCurrentUserRole(companyId);
      return (
        isOwnerRole(role) ||
        (isAdminRole(role) && permission in ['submissions:read', 'submissions:write', 'team:manage', 'webhooks:write', 'integrations:write', 'analytics:read', 'audit:read']) ||
        (isManagerRole(role) && permission in ['submissions:read', 'submissions:write', 'submissions:reply', 'analytics:read', 'audit:read']) ||
        (isViewerRole(role) && permission in ['submissions:read', 'analytics:read'])
      );
    }

    function canManageCompany(companyId) {
      return isUserInCompany(companyId) && canRoleManageCompany(getCurrentUserRole(companyId));
    }

    function isOwner(companyId) {
      return isUserInCompany(companyId) && isOwnerRole(getCurrentUserRole(companyId));
    }

    function canManageTeam(companyId) {
      return isUserInCompany(companyId) && canRoleManageCompany(getCurrentUserRole(companyId));
    }

    function canReadSubmissions(companyId) {
      return isUserInCompany(companyId) && canRoleReadSubmissions(getCurrentUserRole(companyId));
    }

    function canManageSubmissions(companyId) {
      return isUserInCompany(companyId) && canRoleManageSubmissions(getCurrentUserRole(companyId));
    }

    function canReplyToSubmissions(companyId) {
      return isUserInCompany(companyId) && canRoleManageSubmissions(getCurrentUserRole(companyId));
    }


    function isValidEscalationRule(companyId) {
      let d = request.resource.data;
      return request.resource.data.keys().hasAll(['name', 'isActive', 'trigger']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        d.isActive is bool &&
        d.trigger.type in ['time_since_created', 'time_since_status_change', 'time_unassigned'] &&
        (d.trigger.hours is int || d.trigger.hours is float) && d.trigger.hours >= 1 && d.trigger.hours <= 720;
    }

    function isPublicFeedCompany(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.showPublicFeed == true;
    }

    // Public email lookup for /track: this is intentionally constrained to
    // unauthenticated exact-email queries for non-anonymous submissions.
    // Firestore Rules support for introspecting query filters should be verified
    // in the emulator before deploy; if unavailable, move this flow behind a
    // callable Cloud Function with server-side rate limiting.
    function isPublicEmailLookup() {
      return !isAuthenticated() &&
        request.query.limit <= 50 &&
        resource.data.submitterEmail is string &&
        resource.data.submitterEmail == request.query.filters.submitterEmail &&
        resource.data.isAnonymous == false;
    }

    // Returns true when the update touches only the listed fields
    function only(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Validate tracking code format: #FSV-<exactly 4 uppercase alphanumeric chars>
    function isValidTrackingCode(code) {
      return code is string && code.matches('#FSV-[A-Z0-9]{4}');
    }

    // Validate submission fields on direct create (Cloud Functions bypass rules)

    function canReadSubmissionDocument(submissionId) {
      return exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
        canReadSubmissions(get(/databases/$(database)/documents/submissions/$(submissionId)).data.companyId);
    }

    function isValidInternalCommentCreate(submissionId) {
      let d = request.resource.data;
      return canReadSubmissionDocument(submissionId) &&
        d.id is string && d.id.size() > 0 && d.id.size() <= 128 &&
        d.body is string && d.body.size() > 0 && d.body.size() <= 2000 &&
        d.authorId == request.auth.uid &&
        d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 120 &&
        (!('authorAvatar' in d) || d.authorAvatar == null || d.authorAvatar is string) &&
        d.isEdited == false &&
        d.isDeleted == false &&
        d.editedAt == null &&
        (!('parentId' in d) || d.parentId == null || d.parentId is string) &&
        (!('authorType' in d) || d.authorType in ['user', 'system']);
    }

    function isValidInternalCommentUpdate(submissionId) {
      let d = request.resource.data;
      return canReadSubmissionDocument(submissionId) &&
        resource.data.authorId == request.auth.uid &&
        d.authorId == resource.data.authorId &&
        d.createdAt == resource.data.createdAt &&
        d.parentId == resource.data.parentId &&
        d.isDeleted is bool &&
        ((d.isDeleted == true && d.body == null) ||
         (d.body is string && d.body.size() > 0 && d.body.size() <= 2000));
    }

    function isSubmissionMergeUpdate() {
      return canManageSubmissions(resource.data.companyId) && (
        only(['isMerged', 'mergedInto', 'mergedAt', 'mergedBy', 'status', 'resolvedAt', 'updatedAt']) ||
        only(['mergedSubmissions', 'updatedAt'])
      );
    }

    function isValidSubmissionCreate() {
      let d = request.resource.data;
      let validScore = !('satisfactionScore' in d) ||
                       d.satisfactionScore == null ||
                       (d.satisfactionScore is int && d.satisfactionScore >= 1 && d.satisfactionScore <= 5);
      let validLabel = !('satisfactionLabel' in d) ||
                       d.satisfactionLabel == null ||
                       (d.satisfactionLabel is string && d.satisfactionLabel.size() <= 50);
      let validLocation = !('location' in d) ||
                          d.location == null ||
                          (d.location is string && d.location.size() > 0 && d.location.size() <= 120);
      return d.boardId is string && d.boardId.size() > 0 && d.boardId.size() <= 128 &&
             d.companyId is string && d.companyId.size() > 0 && d.companyId.size() <= 128 &&
             d.subject is string && d.subject.size() > 0 && d.subject.size() <= 100 &&
             d.description is string && d.description.size() > 0 && d.description.size() <= 5000 &&
             d.trackingCode is string && isValidTrackingCode(d.trackingCode) &&
             d.status == 'received' &&
             d.priority in ['low', 'medium', 'high', 'critical'] &&
             d.isAnonymous is bool &&
             validScore &&
             validLabel &&
             validLocation;
    }

    // Webhook logs - Cloud Functions write, Admin+ read
    match /webhook_logs/{companyId}/{logId} {
      allow read: if canManageCompany(companyId);
      allow write: if false;
    }

    // Users collection - RBAC enforced
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isUserInCompany(resource.data.companyId);
      // Create: only the authenticated user may create their own doc; role must be valid
      allow create: if request.auth.uid == userId &&
        request.resource.data.id == userId &&
        request.resource.data.companyId is string &&
        request.resource.data.role in ['owner', 'admin', 'manager', 'viewer'];
      // Update: self-update OR manager/admin update that keeps companyId unchanged
      allow update: if (request.auth.uid == userId && request.resource.data.companyId == resource.data.companyId) ||
        (canManageTeam(resource.data.companyId) && request.resource.data.companyId == resource.data.companyId);
      // Delete: team managers may remove other users; cannot self-delete
      allow delete: if canManageTeam(resource.data.companyId) && request.auth.uid != userId;
    }

    // Companies collection
    match /companies/{companyId} {
      // Public get: branding and public feed fields are needed on public pages.
      allow get: if true;
      // Public slug lookup for /r/:companySlug is limited to one company document.
      allow list: if canManageCompany(companyId) || request.query.limit <= 1;
      // Self-service create: the signing-up user may create the company whose ID equals
      // their own UID (this is the pattern used in signUp / loginWithGoogle / loginWithApple).
      // No user doc exists yet at this point so canManageCompany would fail.
      allow create: if request.auth != null && request.auth.uid == companyId;
      allow update: if canManageCompany(companyId);
      allow delete: if isOwner(companyId);

      match /webhook_logs/{logId} {
        allow read: if canManageCompany(companyId);
        allow write: if false;
      }

      // Escalation rules are feature-gated in the app; rules enforce company membership and owner/admin writes.
      match /escalationRules/{ruleId} {
        allow read: if isUserInCompany(companyId);
        allow create: if canManageCompany(companyId) && isValidEscalationRule(companyId);
        allow update: if canManageCompany(companyId) && isValidEscalationRule(companyId);
        allow delete: if canManageCompany(companyId);
      }

      match /audit_logs/{logId} {
        allow read: if canManageCompany(companyId);
        // Authenticated company members may create audit log entries; no updates/deletes
        allow create: if isUserInCompany(companyId);
        allow update, delete: if false;
      }

      // Notifications for @mentions
      match /notifications/{notificationId} {
        allow read: if isUserInCompany(companyId) && resource.data.userId == request.auth.uid;
        allow create: if isUserInCompany(companyId);
        allow update: if isUserInCompany(companyId) && resource.data.userId == request.auth.uid;
      }

      // Saved filters - company members can manage their shared filters
      match /filters/{filterId} {
        allow read: if isUserInCompany(companyId);
        allow create: if isUserInCompany(companyId);
        allow update: if isUserInCompany(companyId);
        allow delete: if isUserInCompany(companyId);
      }

      // Reply templates - authenticated company members read/write
      match /replyTemplates/{templateId} {
        allow read: if isUserInCompany(companyId);
        allow create: if isUserInCompany(companyId) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 80 &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 1000 &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isUserInCompany(companyId);
        allow delete: if isUserInCompany(companyId);
      }
    }

    // Board templates - all authenticated users may read; authenticated users may seed
    match /board_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Boards collection - Role-based access; board doc must carry companyId
    match /boards/{boardId} {
      // Public read: board config (including locations) is needed by the public
      // submit-feedback form (slug query) and the public tracking page (get by ID)
      allow read: if true;
      // create: resource doesn't exist yet, so use request.resource.data
      allow create: if canManageCompany(request.resource.data.companyId);
      // Allow anyone to increment submissionCount by exactly 1 (public form submissions)
      // Location lists and all other board settings are writable by company admins only.
      allow update: if canManageCompany(resource.data.companyId) ||
        (only(['submissionCount']) &&
         request.resource.data.submissionCount == resource.data.get('submissionCount', 0) + 1);
      allow delete: if canManageCompany(resource.data.companyId);
    }

    // Submissions collection - Role-based access
    match /submissions/{submissionId} {
      // Authenticated company members can read their own submissions.
      allow read: if canReadSubmissions(resource.data.companyId);
      // Public tracking page: unauthenticated get by document ID.
      allow get: if resource.data.trackingCode is string;
      // Public tracking page query by tracking code remains limited to one doc.
      // Public resolution feed can list opted-in company submissions for browser aggregation;
      // the UI renders only category/status/createdAt/resolvedAt and never personal fields.
      // For stricter field isolation, move this aggregation behind a Cloud Function.
      allow list: if request.query.limit <= 1 ||
        isPublicEmailLookup() ||
        (request.query.limit <= 1000 && isPublicFeedCompany(resource.data.companyId));
      // Authenticated company member create
      allow create: if isUserInCompany(request.resource.data.companyId) && isValidSubmissionCreate();
      // Public create from the feedback form (works for both unauthenticated visitors
      // and signed-in users submitting on a board outside their own company).
      allow create: if isValidSubmissionCreate();
      allow update: if isSubmissionMergeUpdate() ||
        canManageSubmissions(resource.data.companyId) ||
        (canReplyToSubmissions(resource.data.companyId) && only(['publicReply', 'publicReplyAt', 'publicReplyBy']));
      allow delete: if canManageCompany(resource.data.companyId);


      // Internal comments are team-only and are never readable from public tracking.
      match /internalComments/{commentId} {
        allow read: if canReadSubmissionDocument(submissionId);
        allow create: if isValidInternalCommentCreate(submissionId);
        allow update: if isValidInternalCommentUpdate(submissionId);
        allow delete: if canReadSubmissionDocument(submissionId) && resource.data.authorId == request.auth.uid;
      }


      // Escalation history is informational and written only by Cloud Functions.
      match /escalationLog/{logId} {
        allow read: if canReadSubmissionDocument(submissionId);
        allow write: if false;
      }

      // Attachments subcollection - company members read; Cloud Functions write
      match /attachments/{attachmentId} {
        allow read: if canReadSubmissions(
          get(/databases/$(database)/documents/submissions/$(submissionId)).data.companyId
        );
        allow write: if false;
      }

      // Comments subcollection - company members read; authors manage their own comments
      match /comments/{commentId} {
        allow read: if canReadSubmissions(
          get(/databases/$(database)/documents/submissions/$(submissionId)).data.companyId
        );
        allow create: if isAuthenticated() &&
          isUserInCompany(request.resource.data.companyId) &&
          request.resource.data.author.id == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 5000 &&
          request.resource.data.mentions.size() <= 15 &&
          request.resource.data.mentions.all(uid,
            exists(/databases/$(database)/documents/users/$(uid)) &&
            get(/databases/$(database)/documents/users/$(uid)).data.companyId == request.resource.data.companyId
          );
        allow update: if isAuthenticated() &&
          request.auth.uid == resource.data.author.id &&
          (request.resource.data.content != resource.data.content ||
           request.resource.data.reactions != resource.data.reactions) &&
          request.resource.data.author == resource.data.author;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.author.id;
      }
    }


    // Board cycle archives - company members read, admins manage settings-created cycles.
    match /boardCycles/{cycleId} {
      allow read: if canReadSubmissions(resource.data.companyId);
      allow create: if canManageCompany(request.resource.data.companyId) &&
        request.resource.data.boardId is string &&
        request.resource.data.companyId is string &&
        request.resource.data.cycleNumber is int &&
        request.resource.data.label is string &&
        request.resource.data.isCurrent is bool;
      allow update: if canManageCompany(resource.data.companyId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.boardId == resource.data.boardId;
      allow delete: if canManageCompany(resource.data.companyId);
    }

    // Stripe invoices - company members can read their own invoice history.
    // Writes are server-only via Cloud Functions/Admin SDK webhooks.
    match /invoices/{companyId}/invoices/{invoiceId} {
      allow read: if isUserInCompany(companyId);
      allow write: if false;
    }

    // API Keys collection - Admin+ only
    match /api_keys/{companyId}/{keyId} {
      allow read: if canManageCompany(companyId);
      allow write: if canManageCompany(companyId);
    }

    // API Logs - server-only writes, Admin+ reads
    match /api_logs/{companyId}/{logId} {
      allow read: if canManageCompany(companyId);
      allow write: if false;
    }

    // Team invitations - flat collection used by client code
    match /teamInvitations/{inviteId} {
      // Unauthenticated get is intentional: the Firestore doc ID acts as the
      // secret token embedded in the invite link. Without the exact ID the
      // document cannot be discovered (list is still auth-gated).
      allow get: if true;
      allow list: if isAuthenticated() && canManageTeam(resource.data.companyId);
      allow create: if isAuthenticated() && canManageTeam(request.resource.data.companyId);
      allow delete: if isAuthenticated() && canManageTeam(resource.data.companyId);
      // Invitee may mark only their own invitation as accepted (email must match)
      allow update: if isAuthenticated() &&
        request.auth.token.email == resource.data.email &&
        request.resource.data.status == 'accepted' &&
        only(['status']);
    }

    // Team invitations - Team managers and above (legacy nested path)
    match /team_invitations/{companyId}/{inviteId} {
      allow read: if canManageTeam(companyId);
      allow create: if canManageTeam(companyId);
      allow delete: if canManageTeam(companyId);
    }

    // Audit logs - Admin+ read only
    match /audit_logs/{companyId}/{logId} {
      allow read: if canManageCompany(companyId);
      allow write: if false;
    }

    // Virus scan queue - Cloud Functions only
    match /virus_scan_queue/{scanId} {
      allow read, write: if false;
    }

    // Per-IP rate limit tracking for public endpoints - Cloud Functions only
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Bulk operations - Cloud Functions writes, Owner/Admin/Manager reads
    match /bulkOperations/{operationId} {
      allow read: if isAuthenticated() &&
        isUserInCompany(resource.data.companyId) &&
        (canRoleManageSubmissions(getCurrentUserRole(resource.data.companyId)));
      allow write: if false;
    }

    // Bulk operation logs - Cloud Functions writes, Owner/Admin reads
    match /bulkOperationLogs/{logId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/companies/$(resource.data.companyId)) &&
        isUserInCompany(resource.data.companyId) &&
        (canRoleManageCompany(getCurrentUserRole(resource.data.companyId)));
      allow write: if false;
    }

    // Undo operations - Cloud Functions writes, Owner/Admin/Manager reads
    match /undoOperations/{undoId} {
      allow read: if isAuthenticated() &&
        isUserInCompany(resource.data.companyId) &&
        (canRoleManageSubmissions(getCurrentUserRole(resource.data.companyId)));
      allow write: if false;
    }

    // Archived submissions - Cloud Functions write, Owner/Admin read (compliance)
    match /archived_submissions/{submissionId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/submissions/$(submissionId)) == false &&
        canManageCompany(resource.data.companyId);
      allow write: if false;
    }

    // Deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
